[Unit]
Description=MottoForma Next.js
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/mottoforma/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --port 3010 --hostname 127.0.0.1
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
